[Globals]
ini_version=1
fork=false
port=3390
tcp_nodelay=true
tcp_keepalive=true
security_layer=tls
crypt_level=high
certificate=cert.pem
key_file=key.pem
ssl_protocols=TLSv1.2, TLSv1.3
tls_ciphers=HIGH:!aNULL:!eNULL:!EXPORT:!RC4:!DES:!3DES:!MD5:!PSK:!SRP:!DSS
require_credentials=false
autorun=OHOS
allow_channels=true
allow_multimon=true
bitmap_cache=true
bitmap_compression=true
bulk_compression=true
max_bpp=32
new_cursors=true
use_fastpath=both

[Logging]
LogFile=xrdp.log
LogLevel=INFO
EnableSyslog=false
EnableConsole=true
ConsoleLevel=INFO
EnableProcessId=true

[LoggingPerLogger]

[Channels]
rdpdr=false
rdpsnd=true
drdynvc=true
cliprdr=true
rail=false
xrdpvr=false

[OHOS]
name=HarmonyOS remote assistance
lib=libxrdpohos.@lib_extension@
username=ohos
password=ask
access_code=
port=0
code=0
